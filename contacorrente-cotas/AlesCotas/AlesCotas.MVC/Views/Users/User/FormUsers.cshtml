@using AlesCotas.Application.DTOs.Users
@model EditarUsuarioDto
@{
    bool editMode = !String.IsNullOrWhiteSpace(Model?.Id);
    ViewData["Title"] = (editMode ? "Editar" : "Novo") +  " Usuário";
}

<section id="userForms">
    <div class="back-btn">
        <button onclick="changePage('Users','ListUsers')"><img src="~/imgs/arrow.svg" alt="" srcset=""></button>
        <h4>@ViewData["Title"]</h4>
    </div>
    <span class="line"></span>
    <div class="box-form">
        <div class="box-form-content">
            <div class="col-one">

                @if (!editMode)
                {
                    <form asp-action="BuscarMatricula">
                        <div class="row align-items-end">
                            <div class="form-group mb-3 col-12 col-md-12 col-lg-10">
                                <label for="inputEmail4">Buscar Usuário ALES</label>
                                <input name="consultaMatricula" type="text" class="form-control " id="consultaMatricula" placeholder="Matrícula">
                            </div>
                            <div class="col-12 col-md-12 col-lg-2 mb-3">
                                <button type="submit" class="btn btn-primary w-100">Buscar</button>
                            </div>
                        </div>
                    </form>
                }

                <form asp-action="SaveUser" >
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />
                    <div class="row">
                        <div class="form-group mb-3 col-12 col-md-12 col-lg-5">
                            <label for="inputEmail4">Nome</label>
                            <input asp-for="Nome" type="text" class="form-control" placeholder="Nome" readonly>
                        </div>
                        <div class="form-group mb-3 col-12 col-md-12 col-lg-5">
                            <label for="inputEmail4">E-mail</label>
                            <input asp-for="Email" type="text" class="form-control" placeholder="E-mail" >
                        </div>
                        <div class="form-group mb-3 col-12 col-md-12 col-lg-2">
                            <label for="UserName">N: da matrícula</label>
                            <input asp-for="UserName" type="text" class="form-control" placeholder="N: da matrícula" readonly>
                        </div>
                        <div hidden class="form-group mb-3 col-6 col-md-1 col-lg-1">
                            <label for="inputEmail4">Ativo</label>
                            @Html.CheckBoxFor(m => m.Ativo)
                           @* <label for="inputEmail4">Ativo</label>
                            <input asp-for="Ativo" type="checkbox" class="form-control">*@
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group mb-3 col-12 col-md-12 col-lg-4">
                            <label for="inputEmail4">Setor de lotação *</label>
                            <input asp-for="Setor" type="text" class="form-control " id="inputEmail4" placeholder="" readonly>
                        </div>
                        <div class="form-group mb-3 col-12 col-md-12 col-lg-3">
                            <label for="inputEmail4">Perfil do usuário *</label>
                            <select asp-for="Role" class="form-select" aria-label="Default select example">
                                <option value="User" selected>Usuário</option>
                                <option value="Admin">Administrador</option>
                                </select>
                        </div>
                        <div class="form-group mb-3 col-12 col-md-12 col-lg-5">
                            <label for="inputEmail4">Gabinete vinculado *</label>
                            <select asp-for="IDGabiente" class="form-select" aria-label="Default select example">
                                    <option value="" selected>Selecione um gabinete</option>
                                @foreach (var gabinete in ViewBag?.gabinetes)
                                {
                                    <option value="@gabinete.IDGabinete">@gabinete.Nome</option>
                                }
                                </select>
                        </div>
                    </div>
                    <div class="btn-request-form">
                        <button type="submit" class="btn btn-primary">@(editMode ? "Salvar" : "Cadastrar")</button>
                        <button onclick="changePage('Users','ListUsers')" type="button" class="btn btn-primary btn-primary-outline">Voltar</button>
                        @if (editMode)
                        {
                            <a href="@Url.Action("SendChangePasswordEmailAction", "Users", new { email = Model.Email })">
                            <button type="button" asp-action="" asp-route-email="" class="btn btn-primary btn-primary-outline">Enviar Redefinição de senha</button>
                            </a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
</script>