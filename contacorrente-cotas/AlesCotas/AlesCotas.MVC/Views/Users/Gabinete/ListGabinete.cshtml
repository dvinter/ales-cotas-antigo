@using AlesCotas.Application.DTOs.Filtros
@model ListaPaginada<GabineteDto>
@{
    ViewData["Title"] = "Lista de Gabinetes";
    GabineteFiltroDto filtro = ViewBag.filtro;
    //--bs-gutter-x: 1.5rem;
}

<section id="usersTable">
    <div class="box-title">
        <div class="back-btn">
            <button onclick="changePage('Users','Users')"><img src="~/imgs/arrow.svg" alt="" srcset=""></button>
            <h4>Gabinete</h4>
        </div>

        <div class="box-btn-to-edit">
            <button onclick="changePage('Users','FormGabinete')" class="btn btn-primary px-4 py-2">Novo
                gabinete</button>
        </div>

    </div>
    <span class="line"></span>
    <div class="box-form">
        <div class="box-form-content">
            <div class="box-content-title mb-3">
                <div class="box-text mb-3">
                    <img src="~/imgs/box-icon.svg" alt="">
                    <h4>Lista de Gabinetes</h4>
                </div>
                <form class="w-100 ">
                    <div class="row align-items-end">
                        <div class="form-group mb-3 col-12 col-md-12 col-lg-7">
                            <label for="inputEmail4">Faça sua busca *</label>
                            <input type="text" class="form-control  " id="inputEmail4" name="FiltroTexto" asp-for="@filtro.FiltroTexto"
                            placeholder="Digite para pesquisar">
                        </div>
                        <div class="form-group mb-3 col-12 col-md-12 col-lg-3">
                            <label for="inputEmail4">Selecione um status *</label>
                            <select name="Status" class="form-select" aria-label="Default select example" asp-for="@filtro.Status">
                                <option value="0">Todos</option>
                                <option value="1">Ativos</option>
                                <option value="2">Inativos</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-12 col-lg-2 mb-3">
                                <button class="btn btn-primary w-100">Buscar</button>
                            </div>
                        </div>
                    
                    </form>
                </div>
                <div class="box-table">
                    <div style="margin-bottom: 1rem;" class="table-responsive">
                        <table class="table table-striped  table-hove align-middle ">
                            <thead>
                                <tr>
                                    <th scope="col">Gabinete</th>
                                    <th scope="col">Qtd. de usuários</th>
                                    <th scope="col">Data de criação</th>
                                    <th scope="col">Data de alteração</th>
                                   <th scope="col">Status</th>
                                    <th scope="col">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                            {
                                    <tr>
                                        <td>@Html.DisplayFor(modelItem => item.Nome)</td>
                                        
                                        <td>@Html.DisplayFor(modelItem => item.QtdUsuarios)</td>
                                        <td>@Html.DisplayFor(modelItem => item.CreatedAt)</td>
                                        <td>@Html.DisplayFor(modelItem => item.UpdateAt)</td>
                                        <td>@(item.IsAtivo ? "Ativo" : "Inativo")</td>

                                        <td style="width:100px ;">
                                            <div class="btns-table-action">
                                                @*      <button onclick="refreshUser(@item.Id)" class="btn-options">
                                        <img src="~/imgs/refresh-icon.svg" alt="">
                                        </button>*@

                                              @*  @if (item.IsAtivo)
                                            {
                                                <button class="btn-cancel">
                                                    <a asp-action="Disable" asp-route-id="@item.IDGabinete">
                                                        <img src="~/imgs/cancelado-icon.svg" alt="">
                                                    </a>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn-options">
                                                    <a asp-action="Enable" asp-route-id="@item.IDGabinete">
                                                        <img src="~/imgs/validar.svg" alt="">
                                                    </a>
                                                </button>
                                            }*@

                                                <button class="btn-edit">
                                                    <a asp-action="EditGabinete" asp-route-id="@item.IDGabinete">
                                                        <img src="~/imgs/edit.svg" alt="">
                                                    </a>
                                                </button>
                                              @*  <button class="btn-delete">
                                                <a asp-action="Delete" asp-route-id="@item.IDGabinete">
                                                    <img src="~/imgs/lixo-icon.svg" alt="">
                                                </a>
                                            </button>*@
                                            </div>
                                        </td>
                                    </tr>

                            }


    @*
                            <tr>
                                <td>Adilson Espindula</td>
                                <td>12</td>
                                <td id="brdate">2015-03-25T12:00:00-06:30</td>
                                <td id="brdate">2015-03-25T12:00:00-06:30</td>
                                <td>Inativo</td>
                                <td style="width:100px ;">
                                    <div class="btns-table-action">
                                        <button onclick="refreshUser(10)" class="btn-options">
                                            <img src="~/imgs/refresh-icon.svg" alt="">
                                        </button>
                                        <button onclick="changePage('Users','FormGabineteEdit',10)" class="btn-edit">
                                            <img src="~/imgs/edit.svg" alt="">
                                        </button>
                                    </div>
                                </td>
                            </tr>*@
                            </tbody>
                        </table>
                    </div>
                    <div class="footer-table ">
                        <div>
                        <p>Totais de Gabinetes: @Model.Count de @Model.TotalRegistros</p>
                        </div>
                    <nav aria-label="Page navigation example">
                        <ul class="pagination">

                            <li class="page-item @(Model.TemAnterior? "" : "disabled")">
                                <a class="page-link"  asp-route-NumeroPagina=@(Model.PaginaAtual-1) aria-label="Previous">
                                    <span aria-hidden="true">&laquo;</span>
                                </a>
                            </li>

                            @for (var i = 1; i <= Model.TotalPaginas; i++)
                            {
                                <li class="page-item @(Model.PaginaAtual == i ? "active" : "")">
                                    <a class="page-link"  asp-route-NumeroPagina=@i>@(i)</a>
                                </li>
                            }

                            <li class="page-item @(Model.TemProxima? "" : "disabled")">
                                <a class="page-link"  asp-route-NumeroPagina=@(Model.PaginaAtual+1) aria-label="Next">
                                    <span aria-hidden="true">&raquo;</span>
                                </a>
                            </li>
                        </ul>
                    </nav>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <script>
        function refreshUser() {
            refersh('Alterar status', 'Está operação poderá ser desfeita!').then(result => {
                switch (result.isConfirmed) {
                    case true:
                        console.log('Deletado')
                        break;
                    case false:
                        console.log('Cancelado')
                        break;
                    default:
                    // code block
                }

            })
        }
    </script>
