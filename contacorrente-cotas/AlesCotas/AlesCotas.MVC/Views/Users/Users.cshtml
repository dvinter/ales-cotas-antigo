@{
    ViewData["Title"] = "Usuários";
}
<section id="users">
    <h4>Usuários</h4>
    <span class="line"></span>
    <div class="box-cards row row-cols-auto ">
        <div class="col">
            <div onclick="changePage('Users','ListGabinete')" class="box-card">
                <img src="~/imgs/user-icon-azul.svg" alt="">
                <p>Lista de gabinetes</p>
            </div>
        </div>
        <div class="col">
            <div onclick="changePage('Users','ListUsers')" class="box-card">
                <img src="~/imgs/user-icon-azul.svg" alt="">
                <p>Lista de usuários</p>
            </div>
        </div>
    </div>
</section>
