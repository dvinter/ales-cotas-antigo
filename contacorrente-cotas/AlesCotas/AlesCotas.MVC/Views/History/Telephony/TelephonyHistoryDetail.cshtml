                    </div>
                </div>
                <form action="">
                    <div class="row">
                        <div class="form-group mb-3 col-12 col-md-12">
                            <label for="inputEmail4">Qtd Atualizada *</label>
                            <input oninput="this.value=this.value.replace(/[^0-9]/g,'');" type="number"
                                class="form-control" id="inputEmail4" placeholder="Quantidade de linhas">
                        </div>
                        <div class="form-group mb-3 col col-12">
                            <label for="inputEmail4">Justificativa <span class="required-dot">*</span></label>
                            <textarea placeholder="Descreva o motivo do cancelamento ou alterações feitas."
                                class="form-control" name="" id="" cols="30" rows="3"></textarea>
                        </div>
                    </div>
                </form>
            </div>
                    <div class="modal-footer">
                        <button onclick="changePage('Telephony','TelephonyHistory')" type="button"
                            class="btn btn-primary-outline" data-bs-dismiss="modal">Voltar</button>
                        <div>
                            <button type="button" class="btn btn-primary">Salvar</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
