@{
    ViewData["Title"] = "Postagem";

}
<!--Mesmo css do request -->
<section id="request">
    <div class="back-btn d-flex align-items-center">
        <button onclick="changePage('History','History')"><img src="~/imgs/arrow.svg" alt="" srcset=""></button>
        <h4 style="padding-bottom:0 ;">Postagens</h4>
    </div>
    <span class="line"></span>
    <div class="box-cards row row-cols-auto ">

        <div class="col">
            <div onclick="changePage('PostAr','PostArHistory')" class="box-card">

                <img src="~/imgs/post-ar.svg" alt="">
                <p>Postagens Ar</p>
            </div>
        </div>
        <!--onclick="changePage('Requests','Requests')"-->
        <div class="col">

            <div onclick="changePage('Post','PostHistory')" class="box-card">

                <img src="~/imgs/request-post.svg" alt="">
                <p>Postagens</p>
            </div>
        </div>
    </div>
</section>