@{
    ViewData["Title"] = "Detalhes de Material expediente";
}

<section id="approvedwithouttable">
    <!--CSS NA PASTA SHARED-->
    <div class="back-btn">
        <button onclick="changePage('Material','MaterialHistory')"><img src="~/imgs/arrow.svg" alt=""
                srcset=""></button>
        <h4>Material expediente</h4>
    </div>
    <span class="line"></span>
    <div class="box-form">
        <div class="box-form-content">
            <div class="col-one">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Gab. Dep. Adilson Espindula</h5>
                        <div class="btns-impressao">
                            <span class="px-2"><img src="~/imgs/excel.svg" alt=""></span>
                            <span class="px-2"><img src="~/imgs/pdf.svg" alt=""></span>
                        </div>
                        <!--@@gabinete-->
                    </div>
                    <div class="modal-body">
                        <div class="box-title mb-3">
                            <p>Data: <span id="brdate">2015-03-25T12:00:00-06:30</span></p>
                            <!--variavel razor-->
                            <h4 class="py-2">Material expediente</h4>
                            <p>Você poderá consultar dados e fazer impressão.</p>
                            <div class="box-solitacao-modal pt-2">
                                <p>N° da solicitação: <span>2183-12</span>
                                    <!--variavel razor-->
                                </p>
                            </div>
                        </div>
                        <div>
                            <div class="box-table">
                                <div class="table-responsive">
                                    <table class="table table-striped  table-hove align-middle ">
                                        <thead>
                                            <tr>
                                                <th scope="col">Qtd. Solicitada</th>
                                                <th scope="col">Valor Unitário</th>
                                                <th scope="col">Valor total</th>
                                                <th scope="col">Subitem</th>
                                                <th scope="col">Qtd. Autorizada</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>5</td>
                                                <td id="brmoney">50.50</td>
                                                <td id="brmoney">150.50</td>
                                                <td><span>Caneta</span></td>
                                                <td>5</td>
                                            </tr>
                                            <tr>
                                                <td>5</td>
                                                <td id="brmoney">50.50</td>
                                                <td id="brmoney">150.50</td>
                                                <td><span>Apontador</span></td>
                                                <td>5</td>
                                            </tr>
                                            <tr>
                                                <td>5</td>
                                                <td id="brmoney">50.50</td>
                                                <td id="brmoney">150.50</td>
                                                <td><span>Grampeador</span></td>
                                                <td>5</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="form-group mb-3 col col-12">
                                <label for="inputEmail4">Justificativa <span class="required-dot">*</span></label>
                                <textarea readonly placeholder="Descreva o motivo do cancelamento ou alterações feitas."
                                    class="form-control" name="" id="" cols="30" rows="3"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button onclick="changePage('Material','MaterialHistory')" type="button"
                            class="btn btn-primary-outline" data-bs-dismiss="modal">Voltar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>