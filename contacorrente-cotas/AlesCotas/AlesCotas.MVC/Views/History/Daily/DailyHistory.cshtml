<script>
    (function () {
        const cancelRequest = document.querySelectorAll('#cancelRequest')
        cancelRequest.forEach((btn, index) => {
            btn.addEventListener("click", (e) => {
                deleteSwal('Excluir solicitação', 'Está operação <b>não</b> poderá ser desfeita!').then(result => {
                    switch (result.isConfirmed) {
                        case true:
                            console.log('Deletado')
                            break;
                        case false:
                            console.log('Cancelado')
                            break;
                        default:
                        // code block
                    }

                })
                e.stopPropagation()

            });

        })


    })();
</script>
