@{
    ViewData["Title"] = "Histórico Diária";
}

<section id="historyTable">
    <div class="box-title">
        <div class="back-btn">
            <button onclick="changePage('History','History')" ><img src="~/imgs/arrow.svg" alt="" srcset=""></button>
            <h4>Diária</h4>
        </div>
        <!--
            <div class="box-btn-to-edit">
