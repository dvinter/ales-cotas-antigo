@{
    ViewData["Title"] = " Solicitação de periodicos";
}

<section id="approvedwithouttable">
    <div class="back-btn">
        <button onclick="changePage('Periodicos','ListRequestPeriodicos')">
            <img src="~/imgs/arrow.svg" alt=""
                srcset=""></button>
        <h4>Periódicos</h4>
    </div>
    <span class="line"></span>
    <div class="box-form">
        <div class="box-form-content">
            <div class="col-one">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Gab. Dep. Adilson Espindula</h5>
                        <!--@@gabinete-->

                    </div>
                    <div class="modal-body">
                <div class="box-title mb-3">
                    <p>Data: <span id="brdate">2015-03-25T12:00:00-06:30</span></p>
                    <!--variavel razor-->
                    <h4 class="py-2">Periódicos</h4>
                    <p>Você poderá consultar dados e alterar a quantidade de periódicos.</p>
                    <div class="box-solitacao-modal pt-2">
                        <p>N° da solicitação: <span>2183-12</span>
                            <!--variavel razor-->
                        </p>
                    </div>
                </div>
                <div class="box-description-modal mb-3">

                    <div class="linha-item">
                        <p>Qtd. Solicitada:</p>
                        <p>João Pedro</p>
                    </div>
                    <div class="linha-item">
                        <p>Periódico:</p>
                        <p>A gazeta</p>
                    </div>
                    <div class="linha-item">
                        <div class="linha-item-text">
                            <p>Descrição do item:</p>
                            <p>Acima de tudo, é fundamental ressaltar que a complexidade dos estudos efetuados exige a
                                precisão e a definição do retorno esperado a longo prazo.</p>
                        </div>
                    </div>
                    <div class="linha-item">
                        <p>Tipo de impressão:</p>
                        <p>Digital</p>
                    </div>
                    <div class="linha-item">
                        <p>Periodicidade:</p>
                        <p>Diária</p>
                    </div>
                    <div class="linha-item">
                        <p>Assinatura:</p>
                        <p>Mensal</p>
                    </div>
                    
                    <div class="linha-item">
                        <p>Valor total:</p>
                        <p id="brmoney">6800</p>
                    </div>
                </div>
                <form action="">
                    <div class="row">
                        <div class="form-group mb-3 col-12 col-md-6">
                            <label for="inputEmail4">Qtd Autorizada *</label>
                            <input oninput="this.value=this.value.replace(/[^0-9]/g,'');" type="number"
                                class="form-control" id="inputEmail4" placeholder="Quantidade de diárias">
                        </div>
                        <div class="form-group mb-3 col-12 col-md-6">
                            <label for="inputEmail4">Total aprovado *</label>
                            <input readonly type="text" class="form-control realCoinMask" id="inputEmail4"
                                placeholder="Digite o valor em R$">
                        </div>
                        <div class="form-group mb-3 col col-12">
                            <label for="inputEmail4">Justificativa <span class="required-dot">*</span></label>
                            <textarea placeholder="Descreva o motivo do cancelamento ou alterações feitas."
                                class="form-control" name="" id="" cols="30" rows="3"></textarea>
                        </div>
                    </div>
                </form>
            </div>
                    <div class="modal-footer">
                        <button onclick="changePage('Periodicos','ListRequestPeriodicos')" type="button"
                            class="btn btn-primary-outline" data-bs-dismiss="modal">Fechar</button>
                        <div>
                            <button type="button" class="btn btn-primary btn-cancel-modal">Não aprovar</button>
                            <button type="button" class="btn btn-primary">Aprovar</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script>

</script>
