@{
    ViewData["Title"] = "Periódicos";
}


<section id="periodicosformgestor">
    <div class="box-title-top">
        <div class="back-btn">
            <button onclick="changePage('Periodicos','ListRequestPeriodicos')"><img src="~/imgs/arrow.svg" alt="" srcset=""></button>
            <h4>Periódicos Gestor</h4>
        </div>
    </div>
    <span class="line"></span>
    <div class="box-form">
        <div class="box-form-content">
            <div class="col-one">
                <div class="box-title mb-3">
                    <h4>Solicitar periódicos </h4>
                    <p style="max-width:500px ;" class="text-center">Escolha qual gabinete e informe o tipo de linha e
                        período que o gabinete irá usar o aparelho</p>
                </div>
                <form action="">
                    <div class="row">
                        <div class="form-group mb-3 col-12 ">
                            <label for="inputEmail4">Gabinete *</label>
                            <select class="form-select copy" aria-label="Default select example">
                                <option value="" selected>Selecionar um gabine</option>
                                <option value="1">Dep. Alexandre Espíndula</option>
                                <option value="2">Dep. Alexandre Espíndula</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group mb-3 col-12">
                            <label for="inputEmail4">Periódico *</label>
                            <input type="text" class="form-control" id="qtd" placeholder="Ex.: A Gazeta">
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group mb-3">
                        <label for="inputEmail4">Descrição do periódico</label>
                        <textarea placeholder="Descrição do periódico" class="form-control" name="" id="" cols="30"
                            rows="3"></textarea>
                     </div>
                    </div>
                    <div class="row">
                        <div class="form-group mb-3 col-6">
                            <label for="inputEmail4">Quantidade *</label>
                            <input type="number" class="form-control" id="qtd"  placeholder="Quantidade">
                        </div>
                        <div class="form-group col-6">
                                <label for="inputEmail4">Tipo de impressão <span class="required-dot">*</span></label>
                                <select class="form-select copy" aria-label="Default select example">
                                    <option value="" selected>Selecionar</option>
                                    <option value="1">Digital</option>
                                    <option value="2">Físico</option>
                                </select>
                            </div>
                    </div>
                    <div class="row align-items-center">
                        <div class="form-group mb-3 col-6">
                            <label for="inputEmail4">Valor total da assinatura *</label>
                            <input id="" type="number" class="form-control realCoinMask" id="qtd"   placeholder="0,00">
                        </div>
                         <div class="form-group mb-3 col-6">
                            <label for="inputEmail4">Parcelas *</label>
                            <input type="number" class="form-control" id="qtd"  placeholder="Parcelas">
                        </div>
                    </div>
                    <div class="btn-request-form">
                        <button class="btn btn-primary">Solicitar compra</button>
                        <button type="button" onclick="changePage('Periodicos','ListRequestPeriodicos')" class="btn btn-primary btn-primary-outline">Voltar</button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</section>

<script>

</script>