                                        <p>Vitória-ES <img class="px-2" src="~/imgs/arrow-right.svg" alt=""
                                                srcset="">Vila-Velha-ES</p>
                                    </div>
                                </div>
                            </div>
                            <div class="linha-item">
                                <p>Data da saída:</p>
                                <p id="brdatetime">2015-03-25T12:00:00-06:30</p>
                            </div>
                            <div class="linha-item">
                                <p>Data de retorno:</p>
                                <p id="brdatetime">2015-03-25T12:00:00-06:30</p>
                            </div>
                        </div>
                        <form action="">
                            <div class="row">
                                <div class="form-group mb-3 col-12 col-md-6">
                                    <label for="inputEmail4">Qtd passagens aprovadas *</label>
                                    <input oninput="this.value=this.value.replace(/[^0-9]/g,'');" type="number"
                                        class="form-control" id="inputEmail4" placeholder="Quantidade de diárias">
                                </div>
                                <div class="form-group mb-3 col-12 col-md-6">
                                    <label for="inputEmail4">Total aprovado *</label>
                                    <input readonly type="text" class="form-control realCoinMask" id="inputEmail4"
                                        placeholder="Digite o valor em R$">
                                </div>
                                <div class="form-group mb-3 col col-12">
                                    <label for="inputEmail4">Justificativa <span class="required-dot">*</span></label>
                                    <textarea placeholder="Descreva o motivo do cancelamento ou alterações feitas."
                                        class="form-control" name="" id="" cols="30" rows="3"></textarea>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button onclick="changePage('Ticket','ListRequestTicket')" type="button"
                            class="btn btn-primary-outline" data-bs-dismiss="modal">Fechar</button>
                        <div>
                            <button type="button" class="btn btn-primary btn-cancel-modal">Não aprovar</button>
                            <button type="button" class="btn btn-primary">Aprovar</button>
                        </div>
