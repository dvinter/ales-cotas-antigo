                                <p>Quantidade de passagens:</p>
                                <p>5</p>
                            </div>
                            <div class="linha-item">
                                <p>Valor da passagem:</p>
                                <p id="brmoney">500.80</p>
                            </div>
                            <div class="linha-item">
                                <div class="linha-item-texto">
