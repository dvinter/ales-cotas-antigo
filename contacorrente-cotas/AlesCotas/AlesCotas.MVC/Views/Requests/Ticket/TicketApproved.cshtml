        <h4>Passagem</h4>
    </div>
    <span class="line"></span>
    <div class="box-form">
        <div class="box-form-content">
            <div class="col-one">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Gab. Dep. Adilson Espindula</h5>
                        <!--@@gabinete-->

                    </div>
                    <div class="modal-body">
                        <div class="box-title mb-3">
                            <p>Data: <span id="brdate">2015-03-25T12:00:00-06:30</span></p>
                            <!--variavel razor-->
                            <h4 class="py-2">Passagem</h4>
                            <p>Você poderá consultar dados e alterar a quantidade de diárias.</p>
                            <div class="box-solitacao-modal pt-2">
                                <p>N° da solicitação: <span>2183-12</span>
                                    <!--variavel razor-->
                                </p>
                            </div>
                        </div>
                        <div class="box-description-modal mb-3">

                            <div class="linha-item">
                                <p>Favorecido:</p>
                                <p>João Pedro</p>
                            </div>
                            <div class="linha-item">
                                <p>Cargo:</p>
                                <p>Deputado</p>
                            </div>
                            <div class="linha-item">
                                <p>Companhia aérea:</p>
                                <p>Azul</p>
                            </div>
