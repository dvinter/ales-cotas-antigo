@{
    ViewData["Title"] = "Solicitações diária";
}
<section id="listRequestDaily">
    <div class="box-title">
        <div class="back-btn">
            <button onclick="changePage('Requests','Requests')"><img src="~/imgs/arrow.svg" alt="" srcset=""></button>
            <h4>Diária</h4>
        </div>
        <!---
        <div class="box-btn-to-edit">
            <button onclick="changePage('Requests','Fuel')" class="btn btn-primary px-4 py-2">Editar itens</button>
        </div>
        -->
    </div>
    <span class="line"></span>
    <div class="box-form">
