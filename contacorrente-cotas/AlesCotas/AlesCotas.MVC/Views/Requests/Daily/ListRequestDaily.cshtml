                                        <!--
                                            <button id="cancelRequest" class="btn-cancel"><img src="~/imgs/close.svg"
                                                alt=""></button>
                                        -->
                                        <button onclick="changePage('Daily','DailyApproved')"
                                            class="btn-options"><img src="~/imgs/options.svg" alt=""></button>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>9928999299</td>
                                <td>Adilson Espindula</td>
                                <td>5</td>
                                <td>Gabinete</td>
                                <td id="brmoney">45.82</td>
                                <td id="brdate">2022-03-25T12:00:00-06:30</td>
                                <td style="width:100px ;">
                                    <div class="btns-table-action">
                                        <button id="approvedRequest" class="btn-approved"><img src="~/imgs/validar.svg"
                                                alt=""></button>
                                         <!--
                                            <button id="cancelRequest" class="btn-cancel"><img src="~/imgs/close.svg"
                                                alt=""></button>
                                        -->
                                        <button data-bs-toggle="modal" data-bs-target="#modalCreate"
                                            class="btn-options"><img src="~/imgs/options.svg" alt=""></button>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>9928999299</td>
                                <td>Adilson Espindula</td>
                                <td>6</td>
                                <td>Gabinete</td>
                                <td id="brmoney">872.42</td>
