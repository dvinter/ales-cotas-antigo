            </div>
        </div>
    </div>
</section>

<script>
    (function () {
        
        const approvedRequest = document.querySelectorAll('#approvedRequest')
       
        approvedRequest.forEach((btn, index) => {
            btn.addEventListener("click", (e) => {
                approvedSwal('Aprovar Solicitação', 'Está operação <b>não</b> poderá ser desfeita!').then(result => {
                    switch (result.isConfirmed) {
                        case true:
                            console.log('Deletado')
                            break;
                        case false:
                            console.log('Cancelado')
                            break;
                        default:
                        // code block
                    }

                })
                e.stopPropagation()

            });

        })


    })();
</script>
