                            <div class="box-solitacao-modal pt-2">
                                <p>N° da solicitação: <span>2183-12</span>
                                    <!--variavel razor-->
                                </p>
                            </div>
                        </div>
                        <div class="box-description-modal mb-3">

                            <div class="linha-item">
                                <p>Favorecido:</p>
                                <p>João Pedro</p>
                            </div>
                            <div class="linha-item">
                                <p>Cargo:</p>
                                <p>Deputado</p>
                            </div>
                            <div class="linha-item">
                                <p>Tipo de diária:</p>
                                <p>Nacional (Sem 20%)</p>
                            </div>
                            <div class="linha-item">
                                <div class="linha-item-text">
                                    <p>Motivação pública:</p>
