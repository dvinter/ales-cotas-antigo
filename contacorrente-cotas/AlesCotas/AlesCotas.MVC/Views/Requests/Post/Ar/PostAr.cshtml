@model List<AlesCotas.Application.DTOs.ProdutoDTO>
@{
    ViewData["Title"] = "Postagem Ar";
}

<style>
    a.nostyle:link {
        text-decoration: inherit;
        color: inherit;
        cursor: pointer;
    }

    a.nostyle:visited {
        text-decoration: inherit;
        color: inherit;
        cursor: pointer;
    }
</style>


<section id="subitem">
    <div class="box-title">
        <div class="back-btn">
            <button onclick="changePage('Requests','PostRedir')"><img src="~/imgs/arrow.svg" alt="" srcset=""></button>
            <h4>Postagem Ar</h4>
        </div>
        <div class="box-btn-to-edit">
            <a asp-action="CadastrarSolicitacao" class="btn btn-primary mt-4">
                Nova
                solicitação
            </a>
        </div>
    </div>
    <span class="line"></span>
    <div class="box-cards row row-cols-auto">
        <div class="col">
            <div onclick="changePage('PostAr','PostCreateAr')">
                <div class="box-card ">
                    <div class="card-create">
                        <div class="line-vertical"></div>
                        <div class="line-horizontal"></div>
                    </div>
                    <p class="pt-5">Adicionar item</p>
                </div>
            </div>
        </div>
        <!--onclick="changePage('Requests','FormFuel',1)"-->
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="box-card">
                    <div id="btnModalEdit" class="box-edit">
                        <span></span><span></span><span></span>
                    </div>
                    <div class="text-center">
                        <p>@item.Nome</p>
                        <h3>@string.Format("{0:C}", @item.ValorUnitario)</h3>
                    </div>
                    <div id="modalEdit" class="box-edit-modal display-none-modals">
                        <ul>
                            <li>
                                <a class="nostyle" asp-action="Editar" asp-route-id="@item.IDProduto">
                                    <img src="~/imgs/edit-icon.svg" alt="">Editar
                                </a>
                            </li>
                            <li id="deleteFuel" onclick="Deletar(@item.IDProduto)"><img src="~/imgs/lixo-icon.svg" alt="">Excluir</li>
                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<script>

    function Deletar(id) {

        deleteSwal('Exluir ou Desativar', 'Deseja excluir ou desativar o item selecionado?').then(result => {
            switch (result.isConfirmed) {
                case true:
                    $.ajax({
                        url: "Deletar",
                        data: { id: id },
                        success: function (result) {
                            window.location.reload();
                        }
                    });
                    break;
                case false:
                    console.log('Cancelado')
                    break;
                default:
                // code block
            }
        })
    }

    (function () {

        const modalEdit = document.querySelectorAll('#modalEdit')
        const btnModalEdit = document.querySelectorAll('#btnModalEdit')
        const deleteFuel = document.querySelectorAll('#deleteFuel')
        let indexAnterior = 0;

        btnModalEdit.forEach((btn, index) => {
            btn.addEventListener("click", (e) => {
                if (indexAnterior !== index) {
                    modalEdit[indexAnterior].classList.add("display-none-modals")
                }
                e.stopPropagation()
                modalEdit[index].classList.toggle("display-none-modals")
                indexAnterior = index
            });
            modalEdit[index].addEventListener("mouseleave", (e) => {
                e.stopPropagation()
                e.target.classList.add("display-none-modals")
            });
        })
    })();
</script>