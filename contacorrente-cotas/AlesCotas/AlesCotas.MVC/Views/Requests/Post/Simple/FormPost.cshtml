@{
    ViewData["Title"] = "Postagem Simples";
}


<section id="copy-form">
    <div class="back-btn">
        <button onclick="changePage('Post','Post')"><img src="~/imgs/arrow.svg" alt="" srcset=""></button>
        <h4>Postagem Simples</h4>
    </div>
    <span class="line"></span>
    <div class="box-form">
        <div class="box-form-content">
            <div class="col-one">
                <div class="box-title mb-3">
                    <div class="box-sub-title pb-1">
                        <p><img src="~/imgs/form-money.svg" alt=""> Disponível</p>
                    </div>
                    <h4 id="brmoney">2500.70</h4>
                </div>
                <form action="">
                    <div class="row">
                        <div class="form-group mb-3 col-12 col-md-8">
                            <label for="inputEmail4">Peso da carta comercial</label>
                            <select class="form-select copy" aria-label="Default select example">
                                <option value="" selected>Selecionar um item</option>
                                <option value="1">Cópia colorida</option>
                                <option value="2">Cópia preto e branco</option>
                            </select>
                        </div>
                        <div class="form-group mb-3  col-md-4 col-12">
                            <label for="inputEmail4">Valor médio R$</label>
                            <input type="text" class="form-control realCoinMask" id="inputEmail4" value="4505" readonly>
                        </div>
                    </div>

                    <div class="row align-items-center">
                        <div class="form-group mb-3 col col-12 col-md-12 col-lg-12 col-xl-5 ">
                            <label for="inputEmail4">Quantidade</label>
                            <input type="number" class="form-control" id="qtd" value="0" placeholder="0">
                        </div>
                        <div class="form-group mb-3 col col-9 col-md-9 col-lg-9 col-xl-5">
                            <label for="inputEmail4">Valor total R$</label>
                            <input type="text" class="form-control realCoinMask" id="inputEmail4" value="4505" disabled>
                        </div>
                        <div class="box-btn-add col-3 col-md-3 col-lg-3 col-xl-2">
                            <button type="button" class="btn-entidde-add btn-add">
                                <div class="line-vertical"></div>
                                <div class="line-horizontal"></div>
                            </button>
                        </div>
                    </div>
                    <div class="mb-3 row row-cols-2 listar">
                        <!--Lista-->
                    </div>

                    <div class="box-updated-value mb-3">
                        <div class="pb-1">
                            <p>Saldo atualizado</p>
                        </div>
                        <h4>R$ 2.500,00</h4>
                    </div>
                    <div class="btn-request-form">
                        <button class="btn btn-primary">Solicitar compra</button>
                        <button onclick="changePage('Post','Post')" type="button" class="btn btn-primary btn-primary-outline">Voltar</button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</section>

<script>
 
    (function () {

        const copySelect = document.querySelector('.copy')
        const qtd = document.querySelector('#qtd')
        const btnAdd = document.querySelector('.btn-add')
        const listar = document.querySelector('.listar')
        let btnDelete = document.querySelectorAll('.btn-delete')
        let listShow = ''
        let copyObj = {};
        let arrayCopyobj = [];//esse vai para o servidor

        copySelect.addEventListener(`change`, (e) => {
            const select = e.target;
            const value = select.value;
            const desc = select.options[select.selectedIndex].text;

            copyObj.id = value;
            copyObj.name = desc;
            e.stopPropagation()
        });
        btnAdd.addEventListener('click', (e) => {
            addItem()
            e.stopPropagation()
        });

        function addItem() {
            if (copyObj.id === undefined || copyObj.id === '') {
                return
            }
            arrayCopyobj.push(copyObj)
            copyObj = {}
            arrayCopyobj.forEach((e, index) => {
                listShow += `
                       <div class="col col-md-12 col-lg-12 col-xl-6 col-12 my-2 fadeIn">
                            <div class="box-itens-selected ">
                                <p><b>Item: </b> ${e.name} - <b>Qtd: </b>5 - <b>Custo R$</b> 45,50</p>
                                <span class="btn-delete">
                                    <svg width="18" height="20" viewBox="0 0 18 20" fill="none"
                                        xmlns="http://www.w3.org/2000/svg">
                                        <path
                                            d="M1 4.5C0.447715 4.5 0 4.94772 0 5.5C0 6.05228 0.447715 6.5 1 6.5L1 4.5ZM17 6.5C17.5523 6.5 18 6.05228 18 5.5C18 4.94772 17.5523 4.5 17 4.5V6.5ZM6 16.5C6 17.0523 6.44772 17.5 7 17.5C7.55228 17.5 8 17.0523 8 16.5H6ZM8 9C8 8.44772 7.55228 8 7 8C6.44772 8 6 8.44772 6 9H8ZM10 16.5C10 17.0523 10.4477 17.5 11 17.5C11.5523 17.5 12 17.0523 12 16.5H10ZM12 9C12 8.44772 11.5523 8 11 8C10.4477 8 10 8.44772 10 9H12ZM2.5 5.5L2.5 17H4.5L4.5 5.5L2.5 5.5ZM5.5 20L12.5 20V18L5.5 18V20ZM15.5 17L15.5 5.5L13.5 5.5L13.5 17H15.5ZM3.5 4.5H1L1 6.5H3.5L3.5 4.5ZM14.5 6.5L17 6.5V4.5L14.5 4.5V6.5ZM5 4.5H3.5L3.5 6.5L5 6.5V4.5ZM6 5.5L6 3L4 3L4 5.5H6ZM7 2L11 2V0L7 0V2ZM14.5 4.5H13V6.5H14.5V4.5ZM13 4.5L5 4.5V6.5L13 6.5V4.5ZM12 3V5.5H14V3H12ZM8 16.5L8 9H6L6 16.5H8ZM12 16.5V9H10V16.5H12ZM11 2C11.5523 2 12 2.44772 12 3H14C14 1.34315 12.6569 0 11 0V2ZM6 3C6 2.44772 6.44772 2 7 2V0C5.34315 0 4 1.34315 4 3L6 3ZM12.5 20C14.1569 20 15.5 18.6569 15.5 17H13.5C13.5 17.5523 13.0523 18 12.5 18V20ZM2.5 17C2.5 18.6569 3.84315 20 5.5 20V18C4.94772 18 4.5 17.5523 4.5 17H2.5Z"
                                            fill="#676D85" />
                                    </svg>
                                </span>
                            </div>
                        </div>`
            });
            listar.innerHTML = listShow

            refreshDelete()
        }

        function refreshDelete() {
            listShow = ''
            btnDelete = document.querySelectorAll('.btn-delete')
            btnDelete.forEach((btn, index) => {
                btn.addEventListener("click", (e) => {
                    removeItem(index)

                })
            })
        }

        function removeItem(index) {
            arrayCopyobj.splice(index, 1);
            arrayCopyobj.forEach((e, index) => {
                listShow += `
                       <div class="col col-md-12 col-lg-12 col-xl-6 col-12 my-2 ">
                            <div class="box-itens-selected ">
                                <p><b>Item: </b> ${e.name} - <b>Qtd: </b>5 - <b>Custo R$</b> 45,50</p>
                                <span class="btn-delete">
                                    <svg width="18" height="20" viewBox="0 0 18 20" fill="none"
                                        xmlns="http://www.w3.org/2000/svg">
                                        <path
                                            d="M1 4.5C0.447715 4.5 0 4.94772 0 5.5C0 6.05228 0.447715 6.5 1 6.5L1 4.5ZM17 6.5C17.5523 6.5 18 6.05228 18 5.5C18 4.94772 17.5523 4.5 17 4.5V6.5ZM6 16.5C6 17.0523 6.44772 17.5 7 17.5C7.55228 17.5 8 17.0523 8 16.5H6ZM8 9C8 8.44772 7.55228 8 7 8C6.44772 8 6 8.44772 6 9H8ZM10 16.5C10 17.0523 10.4477 17.5 11 17.5C11.5523 17.5 12 17.0523 12 16.5H10ZM12 9C12 8.44772 11.5523 8 11 8C10.4477 8 10 8.44772 10 9H12ZM2.5 5.5L2.5 17H4.5L4.5 5.5L2.5 5.5ZM5.5 20L12.5 20V18L5.5 18V20ZM15.5 17L15.5 5.5L13.5 5.5L13.5 17H15.5ZM3.5 4.5H1L1 6.5H3.5L3.5 4.5ZM14.5 6.5L17 6.5V4.5L14.5 4.5V6.5ZM5 4.5H3.5L3.5 6.5L5 6.5V4.5ZM6 5.5L6 3L4 3L4 5.5H6ZM7 2L11 2V0L7 0V2ZM14.5 4.5H13V6.5H14.5V4.5ZM13 4.5L5 4.5V6.5L13 6.5V4.5ZM12 3V5.5H14V3H12ZM8 16.5L8 9H6L6 16.5H8ZM12 16.5V9H10V16.5H12ZM11 2C11.5523 2 12 2.44772 12 3H14C14 1.34315 12.6569 0 11 0V2ZM6 3C6 2.44772 6.44772 2 7 2V0C5.34315 0 4 1.34315 4 3L6 3ZM12.5 20C14.1569 20 15.5 18.6569 15.5 17H13.5C13.5 17.5523 13.0523 18 12.5 18V20ZM2.5 17C2.5 18.6569 3.84315 20 5.5 20V18C4.94772 18 4.5 17.5523 4.5 17H2.5Z"
                                            fill="#676D85" />
                                    </svg>
                                </span>
                            </div>
                        </div>`
            });
            listar.innerHTML = listShow
            refreshDelete()
        }
    })();
</script>