@{
    ViewData["Title"] = "Material expediente";
}

<style>
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
</style>

<section id="materialform">
    <div class="back-btn">
        <button onclick="changePage('Material','Material')"><img src="~/imgs/arrow.svg" alt="" srcset=""></button>
        <h4>Material expediente</h4>
    </div>
    <span class="line"></span>
    <div class="box-form">
        <div class="box-form-content">
            <div class="col-one">
                <div class="box-title mb-3">
                    <div class="box-sub-title pb-1">
                        <p><img src="~/imgs/form-money.svg" alt=""> Disponível</p>
                    </div>
                    <h4 id="brmoney">2500.70</h4>
                </div>
                <form action="">
                    <div class="row">
                        <div class="form-group mb-3 col-12 col-lg-8 col-xl-10 col-md-7">
                            <label>Tipo de material</label>
                            <select id="itemSelecionado" class="form-select copy"
                                    asp-items="@(new SelectList(ViewBag.Items, "IDProduto", "Nome"))" onchange="onSelectChange()"></select>
                            @*<select class="form-select copy" aria-label="Default select example">
                            <option value="" selected>Selecionar um item</option>
                            <option value="1">Cópia colorida</option>
                            <option value="2">Cópia preto e branco</option>
                            </select>*@
                        </div>
                        <div class="form-group mb-3 col-lg-4 col-xl-2 col-md-5 col-12">
                            <label>Valor médio R$</label>
                            <input type="text" id="valorMedio" class="form-control" disabled />
                        </div>
                    </div>

                    <div class="row align-items-center">
                        <div class="form-group mb-3 col col-12 col-md-12 col-lg-12 col-xl-5 ">
                            <label>Quantidade</label>
                            <input id="qtd" type="number" 
                                class="form-control" value="1" placeholder="0"
                                   onkeypress="preventNonNumericalInput(event)"
                                oninput="calcularTotal()">
                        </div>
                        <div class="form-group mb-3 col col-9 col-md-9 col-lg-9 col-xl-5">
                            <label>Valor total R$</label>
                            <input type="text" class="form-control" id="valorTotal" value="0" disabled>
                        </div>
                        <div class="box-btn-add col-3 col-md-3 col-lg-3 col-xl-2">
                            <button id="btnAdd" type="button" class="btn-entidde-add btn-add">
                                <div class="line-vertical"></div>
                                <div class="line-horizontal"></div>
                            </button>
                        </div>
                    </div>
                    <div id="lista" class="mb-3 row row-cols-2 listar">
                        <!--Lista-->
                    </div>

                    <div class="box-updated-value mb-3">
                        <div class="pb-1">
                            <p>Saldo atualizado</p>
                        </div>
                        <h4>R$ 2.500,00</h4>
                    </div>
                    <div class="btn-request-form">
                        <button type="button" class="btn btn-primary" onclick="salvar()">Solicitar compra</button>
                        <button type="button" onclick="changePage('Material','Material')" class="btn btn-primary btn-primary-outline">Voltar</button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</section>

<script>
    // Array de items
    const items = [];

    // Produtos
    const produtos = @Html.Raw(Json.Serialize(ViewBag.Items));
    console.log("produtos", produtos);

    // Botão adicionar
    const btnAdd = document.getElementById("btnAdd");

    // Lista
    const lista = document.getElementById("lista");

    // Inputs
    const select = document.getElementById("itemSelecionado");
    const quantidade = document.getElementById("qtd");
    const valorTotal = document.getElementById("valorTotal");

    // Campo valor medio
    const valorMedio = document.getElementById("valorMedio");

    btnAdd.addEventListener('click', (e) => {
        console.log("Ola mundo", select.options[select.selectedIndex].innerHTML, select.options[select.selectedIndex].value, quantidade.value);
        addItem();
        e.stopPropagation();
    });

    function calcularTotal() {
        const total = quantidade.value * produtos.find(p => p.IDProduto === parseInt(select.options[select.selectedIndex].value)).ValorUnitario;
        valorTotal.value = formatter.format(total);
    }

    function addItem() {

        if (quantidade.value <= 0) {
            infoSwal("Insira um valor valido para quantidade");
            return;
        }

        if (items.findIndex(i => i.IDProduto == parseInt(select.options[select.selectedIndex].value)) != -1) 
        {
            var index = items.findIndex(i => i.IDProduto == parseInt(select.options[select.selectedIndex].value));
            
            items[index].QuantidadeSolicitada += parseInt(quantidade.value);
            atualizarLista();
            return;
        }

        items.push({
            IDProduto: parseInt(select.options[select.selectedIndex].value),
            QuantidadeSolicitada: parseInt(quantidade.value),
            ValorUnitario: 0
        });

        atualizarLista();
        console.log(produtos);
    };

    function deletarItem(index) {
        console.log(items.length);
        items.splice(index, 1);
        atualizarLista();
    }

    function atualizarLista() {
        lista.innerHTML = '';
        for (item of items) {

            lista.innerHTML += `
                <div class="col col-md-12 col-lg-12 col-xl-6 col-12 my-2 fadeIn">
                    <div class="box-itens-selected ">
                            <p>
                                <b>Item: </b> ${select.options[select.selectedIndex].innerHTML} -
                                    <b>Qtd: </b>${item.QuantidadeSolicitada} -
                                <b>Custo:</b><span>${formatter.format(produtos.find(p => p.IDProduto === item.IDProduto).ValorUnitario * item.QuantidadeSolicitada)} </span>
                            </p>
                        <span class="btn-delete">
                            <svg width="18" height="20" viewBox="0 0 18 20" fill="none"
                                xmlns="http://www.w3.org/2000/svg">
                                <path
                                    d="M1 4.5C0.447715 4.5 0 4.94772 0 5.5C0 6.05228 0.447715 6.5 1 6.5L1 4.5ZM17 6.5C17.5523 6.5 18 6.05228 18 5.5C18 4.94772 17.5523 4.5 17 4.5V6.5ZM6 16.5C6 17.0523 6.44772 17.5 7 17.5C7.55228 17.5 8 17.0523 8 16.5H6ZM8 9C8 8.44772 7.55228 8 7 8C6.44772 8 6 8.44772 6 9H8ZM10 16.5C10 17.0523 10.4477 17.5 11 17.5C11.5523 17.5 12 17.0523 12 16.5H10ZM12 9C12 8.44772 11.5523 8 11 8C10.4477 8 10 8.44772 10 9H12ZM2.5 5.5L2.5 17H4.5L4.5 5.5L2.5 5.5ZM5.5 20L12.5 20V18L5.5 18V20ZM15.5 17L15.5 5.5L13.5 5.5L13.5 17H15.5ZM3.5 4.5H1L1 6.5H3.5L3.5 4.5ZM14.5 6.5L17 6.5V4.5L14.5 4.5V6.5ZM5 4.5H3.5L3.5 6.5L5 6.5V4.5ZM6 5.5L6 3L4 3L4 5.5H6ZM7 2L11 2V0L7 0V2ZM14.5 4.5H13V6.5H14.5V4.5ZM13 4.5L5 4.5V6.5L13 6.5V4.5ZM12 3V5.5H14V3H12ZM8 16.5L8 9H6L6 16.5H8ZM12 16.5V9H10V16.5H12ZM11 2C11.5523 2 12 2.44772 12 3H14C14 1.34315 12.6569 0 11 0V2ZM6 3C6 2.44772 6.44772 2 7 2V0C5.34315 0 4 1.34315 4 3L6 3ZM12.5 20C14.1569 20 15.5 18.6569 15.5 17H13.5C13.5 17.5523 13.0523 18 12.5 18V20ZM2.5 17C2.5 18.6569 3.84315 20 5.5 20V18C4.94772 18 4.5 17.5523 4.5 17H2.5Z"
                                    fill="#676D85" />
                            </svg>
                        </span>
                    </div>
                </div>`
        }
        refreshDelete();
    }

    function refreshDelete() {
        btnDelete = document.querySelectorAll('.btn-delete')
        btnDelete.forEach((btn, index) => {
            btn.addEventListener("click", (e) => {
                deletarItem(index);
                e.stopPropagation();
            })
        })
    }

    function onSelectChange() {

        const valorUnitario = produtos.find(p => p.IDProduto === parseInt(select.options[select.selectedIndex].value)).ValorUnitario;
        valorMedio.value = formatter.format(valorUnitario);
        calcularTotal();
    }

    function salvar() {

        console.log("quantidade", items[0].QuantidadeSolicitada)

        if (!items.length) {
            infoSwal("Informe pelo menos 1 item!");
            return;
        }

        $.ajax({
            contentType: 'application/json',
            dataType: 'json',
            type: 'POST',
            url: "CadastrarSolicitacao",
            data: JSON.stringify(items),
            success: function (data) {
                window.location.href = data;
            },
            error: function (data) {
            }
        });
    }

    setTimeout(() => {
        onSelectChange();
    }, 100);
</script>