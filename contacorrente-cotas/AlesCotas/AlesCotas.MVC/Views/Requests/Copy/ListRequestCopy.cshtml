@model ListaPaginada<SolicitacaoDTO>
@{
    ViewData["Title"] = "Solicitações Cópia Reprográfica";
}
<section id="listRequestCopy">
    <div class="box-title">
        <div class="back-btn">
            <button onclick="changePage('Requests','Requests')"><img src="~/imgs/arrow.svg" alt="" srcset=""></button>
            <h4>Cópia Reprográfica</h4>
        </div>
        <div class="box-btn-to-edit">
            <button onclick="changePage('Copy','Copy')" class="btn btn-primary px-4 py-2">Editar itens</button>
        </div>
    </div>
    <span class="line"></span>
    <div class="box-form">
        <div class="box-form-content">
            <div class="box-content-title mb-3">
                <div class="box-text mb-3">
                    <img src="~/imgs/box-icon.svg" alt="">
                    <h4>Lista de solicitações</h4>
                </div>
                <div class="box-input ">
                    <div class="input-with-icon">
                        <input type="text" class="form-control " id="" placeholder="Pesquisar por gabinete" value="">
                        <img src="~/imgs/search-place.svg" alt="">
                    </div>
                    <button class="btn btn-primary px-4 ">Buscar</button>
                </div>
            </div>
            <div class="box-table">
                <div class="table-responsive">
                    <table class="table table-striped  table-hove align-middle ">
                        <thead>
                            <tr>
                                <th scope="col">N: da solicitação</th>
                                <th scope="col">Gabinete</th>
                                <th scope="col">Items</th>
                                <th scope="col">Quantidade</th>
                                <th scope="col">Valor total</th>
                                <th scope="col">Data</th>
                                <th scope="col">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var element in Model)
                            {
                                <tr>
                                    <td>@element.IDSolicitacao</td>
                                    <td>Adilson Espindula</td>
                                    <td class="space-table">
                                        @foreach(var item in element.Items)
                                        {
                                            <span>@item.Produto.Nome</span>
                                        }
                                    </td>
                                    <td>@element.Items.Count</td>
                                    <td>@string.Format("{0:C}", element.ValorSolicitado)</td>
                                    <td>@element.CreatedAt</td>
                                    <td style="width:100px ;">
                                        <div class="btns-table-action">
                                            <button class="btn-approved" title="Aprovar" onclick="Aprovar(@element.IDSolicitacao)">
                                                <img src="~/imgs/validar.svg"
                                                 alt="">
                                            </button>
                                            <a class="btn-options" title="Ver Detalhes" asp-action="Detalhes" asp-route-id="@element.IDSolicitacao">
                                                <img src="~/imgs/options.svg" alt="">
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="footer-table w-100 d-flex justify-content-center">
                    <paging page-size="@Model.TamanhoPagina"
                            page-no="@Model.PaginaAtual"
                            total-records="@Model.TotalRegistros"
                            show-page-size-nav="false"
                            sr-text-first="Primeira"
                            sr-text-last="Ultima"
                            sr-text-previous="Anterior"
                            sr-text-next="Próxima"
                            text-first=""
                            text-last=""
                            text-previous=""
                            text-next=""
                            url-template="?pagina={0}">
                    </paging>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    function Aprovar(id) {
        confirmSwal('Aprovar Solicitação', 'Está operação <b>não</b> poderá ser desfeita!').then(result => {
            if (result.isConfirmed) {
                $.ajax({
                    url: "Aprovar",
                    data: { id: id },
                    success: function (data) {
                        window.location.href = data;
                    }
                });
            }
        })
    }
</script>
