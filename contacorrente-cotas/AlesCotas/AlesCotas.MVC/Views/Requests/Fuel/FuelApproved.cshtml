@model SolicitacaoValidacao
@{
    ViewData["Title"] = " Solicitação de combustível";
}

<section id="approvedwithouttable">
    <div class="back-btn">
        <button onclick="changePage('Fuel','ListRequestFuel')"><img src="~/imgs/arrow.svg" alt="" srcset=""></button>
        <h4>Combustível</h4>
    </div>
    <span class="line"></span>
    <div class="box-form">
        <div class="box-form-content">
            <div class="col-one">
                <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Gab. Dep. Adilson Espindula</h5><!--@@gabinete-->
            </div>
            <div class="modal-body">
                <div class="box-description-modal mb-3">
                    <div class="box-title">
                        <p>@ViewBag.Solicitacao.Tipo</p>
                    </div>
                    <span class="line"></span>
                    <div class="linha-item">
                        <p>N° da Solicitação:</p>
                        <p>@ViewBag.Solicitacao.IDSolicitacao</p>
                    </div>
                    <div class="linha-item">
                        <p>Data:</p>
                        <p>@ViewBag.Solicitacao.CreatedAt</p>
                    </div>
                    <div class="linha-item">
                        <p>Subitem:</p>
                        <p>@((ViewBag.Solicitacao.Items as ICollection<SolicitacaoItemDTO>).First().Produto.Tipo.Nome)</p>
                    </div>
                    <div class="linha-item">
                        <p>Quantidade (L):</p>
                        <p>@((ViewBag.Solicitacao.Items as ICollection<SolicitacaoItemDTO>).First().QuantidadeSolicitada)</p>
                    </div>
                    <div class="linha-item">
                        <p>Total:</p>
                        <p>@string.Format("{0:C}", ViewBag.Solicitacao.ValorSolicitado)</p>
                    </div>
                </div>
                <form method="post">
                    <input type="hidden" asp-for="IDSolicitacao"/>
                    <div class="form-group mb-3">
                        <label asp-for="ValorAtualizado">Total aprovado *</label>
                        <input type="text" class="form-control realCoinMask" asp-for="ValorAtualizado"
                            placeholder="Digite o valor em R$">
                         <span asp-validation-for="ValorAtualizado" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3 col col-12">
                        <label asp-for="Justificativa">Justificativa </label>
                        
                        <textarea placeholder="Descreva o motivo do cancelamento ou alterações feitas."
                                          class="form-control" cols="30" rows="3" asp-for="Justificativa"
                        ></textarea>
                         <span asp-validation-for="Justificativa" class="text-danger"></span>
                    </div>
                    <div class="modal-footer">
                        <button onclick="changePage('Fuel','ListRequestFuel')" type="button" class="btn btn-primary-outline" data-bs-dismiss="modal">Voltar</button>
                        <div>
                            <button type="submit" asp-action="Negar" class="btn btn-primary btn-cancel-modal">Negar</button>
                            <button type="submit" asp-action="Aprovar" class="btn btn-primary">Aprovar</button>
                            
                            @*<a asp-action="Negar" asp-route-id="@Model.IDSolicitacao" class="btn btn-primary btn-cancel-modal">
                                Não Aprovar
                            </a>
                            <a asp-action="Aprovar" asp-route-id="@Model.IDSolicitacao" class="btn btn-primary">
                                Aprovar
                            </a>*@
                        </div>
                    </div>
                </form>
            </div>
        </div>
            </div>

        </div>
    </div>
</section>
<script>

</script>
