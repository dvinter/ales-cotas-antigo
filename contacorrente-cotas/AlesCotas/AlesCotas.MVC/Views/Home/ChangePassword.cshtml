@{
    ViewData["Title"] = "Alterar senha";
}

<section id="password">
    <div class="box-title">
        <h4>Alterar senha</h4>
    </div>
    <span class="line"></span>
    <div class="box-box">
        <div class="row align-items-center justify-content-between">
            <div class="col col-12 col-md-6 ">
                <form class="w-100 ">
                    <div class="row align-items-end">
                        <div class="form-group mb-3">
                            <label for="inputEmail4">Senha atual *</label>
                            <input type="text" class="form-control" id="inputEmail4"  placeholder="Senha atual">
                        </div>
                        <div class="form-group mb-3">
                            <label for="inputEmail4">Nova senha *</label>
                            <input type="text" class="form-control" id="inputEmail4" placeholder="Nova senha" >
                        </div>
                        <div class="form-group mb-3">
                            <label for="inputEmail4">Confirme sua nova senha  *</label>
                            <input type="text" class="form-control" id="inputEmail4" placeholder="Confirme sua nova senha " >
                        </div>
                    </div>
                    <div class="row align-items-end">
                        <div class="col-12 col-md-12 col-lg-12 mb-3">
                            <button class="btn btn-primary w-100">Salvar</button>
                        </div>
                    </div>

                </form>
            </div>
            <div class="col col-12 col-md-6 ">
                <div class="box-img-password">
                    <img src="~/imgs/modal-password.svg" alt="" srcset="">
                </div>
            </div>
        </div>
    </div>
</section>
