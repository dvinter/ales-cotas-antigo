@{
    ViewData["Title"] = "Cadastro da cota";
}


<section id="formbalance">
    <div class="back-btn">
        <button onclick="changePage('Balance','Balance')"><img src="~/imgs/arrow.svg" alt="" srcset=""></button>
        <h4>Cadastro da cota</h4>
    </div>
    <span class="line"></span>
    <div class="box-form">
        <div class="box-form-content">
            <div class="col-one">
                <div class="box-title text-center mb-4">
                    <h4 class="mb-2">Cadastrar </h4>
                    <p>Os gabinetes receberão automaticamente, <b>no primeiro dia do mês</b>, a cota cadastrada nos campos abaixo.</p>
                </div>
                <form action="">
                    <div class="row">
                        <div class="form-group mb-3 col-12 col-md-12 col-lg-6">
                            <label for="inputEmail4">Valor da cota mensal *</label>
                            <input type="text" class="form-control realCoinMask" id="inputEmail4" placeholder="Digite o valor em R$">
                        </div>
                        <div class="form-group mb-3 col-12 col-md-12 col-lg-6">
                            <label for="inputEmail4">Data de referência *</label>
                            <input type="date" class="form-control " id="inputEmail4" >
                        </div>
                        
                    </div>
                    <div class="btn-request-form">
                        <button class="btn btn-primary">Cadastrar</button>
                        <button onclick="changePage('Balance','Balance')" type="button" class="btn btn-primary btn-primary-outline">Voltar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
</script>