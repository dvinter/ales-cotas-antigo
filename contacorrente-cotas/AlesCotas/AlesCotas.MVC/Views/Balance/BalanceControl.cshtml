@{
    ViewData["Title"] = "Controle de cotas";
}

<section id="balancecontrol">
    <div class="box-title">
        <div class="back-btn">
            <button onclick="changePage('Balance','Balance')"><img src="~/imgs/arrow.svg" alt="" srcset=""></button>
            <h4>Controle de cotas</h4>
        </div>

        <div class="box-btn-to-edit">
